{
  "manifest_version": 3,
  "name": "Gauntlet Timer",
  "version": "1.0.0",
  "description": "Affiche le timer Gauntlet Challenge dans la barre du navigateur.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gauntlet Timer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gauntlet-timer@local",
      "strict_min_version": "109.0"
    }
  }
}
